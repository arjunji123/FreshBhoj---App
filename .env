APP_ENV=dev
APP_NAME=FreshBhoj

# Base URL of the FreshBhoj API, including the /api/v1 prefix.
#   Android emulator  → http://10.0.2.2:3000/api/v1  (10.0.2.2 is the host machine)
#   iOS simulator     → http://localhost:3000/api/v1
#   Physical device   → http://<your-LAN-ip>:3000/api/v1
API_BASE_URL=https://freshbhoj-backend.vercel.app/api/v1

# Google Maps API key — needs the Maps SDK for Android and the Geocoding API
# enabled on the same key. iOS uses Apple Maps and does not need this key.
GOOGLE_MAPS_API_KEY=AIzaSyCbEHcUa3mPQso5bN_YQJKfTmS3QlFAs5I
