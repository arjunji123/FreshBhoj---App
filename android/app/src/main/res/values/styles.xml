<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowSplashScreenBackground">@color/splash_red</item>
        <!-- No launcher icon here — it would show as a mismatched circular
             badge before our own SplashScreen (FreshBhoj wordmark + plates)
             takes over. A real transparent PNG (not a <shape>, which has no
             intrinsic size and falls back to the launcher icon) keeps this
             frame to just the brand-red background. No icon-background-color
             either — that draws its own circle even with nothing on it. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">1</item>
    </style>

     <color name="splash_red">#FF6B6B</color>
</resources>