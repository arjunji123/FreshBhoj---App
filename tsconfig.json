{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@app/*": ["./src/app/*"],
      "@utils/*": ["./src/utils/*"],
      "@features/*": ["./src/features/*"],
      "@assets/*": ["./assets/*"],
      "@animations/*": ["./src/animations/*"],
      "@api/*": ["./src/api/*"],
      "@api": ["./src/api/index"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
